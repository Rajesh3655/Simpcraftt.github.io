{
  "name": "infibolt-platform",
  "version": "3.1.0",
  "private": true,
  "workspaces": [
    "infibolt-frontend",
    "infibolt-admin",
    "infibolt-backend"
  ],
  "scripts": {
    "dev:frontend": "npm --workspace infibolt-frontend run dev",
    "dev:admin": "npm --workspace infibolt-admin run dev",
    "dev:backend": "npm --workspace infibolt-backend run dev",
    "build:frontend": "npm --workspace infibolt-frontend run build",
    "build:admin": "npm --workspace infibolt-admin run build",
    "build:all": "npm run build:frontend && npm run build:admin",
    "check:backend": "npm --workspace infibolt-backend run check",
    "typecheck:frontend": "npm --workspace infibolt-frontend run typecheck",
    "typecheck:admin": "npm --workspace infibolt-admin run typecheck",
    "audit:all": "npm audit --workspaces",
    "preprod:check": "npm run check:backend && npm run typecheck:frontend && npm run typecheck:admin && npm run build:all",
    "preprod:audit": "npm run audit:all"
  }
}
