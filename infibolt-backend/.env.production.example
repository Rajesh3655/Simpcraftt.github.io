NODE_ENV=production
HOST=0.0.0.0
PORT=3000
API_ORIGIN=https://api.infibolt.com
FRONTEND_ORIGIN=https://infibolt.com
ADMIN_ORIGIN=https://admin.infibolt.com
CORS_ORIGINS=https://admin.infibolt.com,https://infibolt.com
MONGODB_URI=mongodb+srv://INFIBOLT_APP_USER:STRONG_PASSWORD@CLUSTER.mongodb.net
MONGODB_DB=infibolt_prod
JWT_ACCESS_SECRET=GENERATE_64_PLUS_RANDOM_CHARS
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_64_PLUS_RANDOM_CHARS
COOKIE_SECRET=GENERATE_DIFFERENT_64_PLUS_RANDOM_CHARS
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
BCRYPT_ROUNDS=12
MAX_UPLOAD_BYTES=5242880
UPLOAD_PROVIDER=local
UPLOAD_BASE_PATH=/home/USER/domains/api.infibolt.com/infibolt-backend/uploads
ALLOW_PRODUCTION_SEED=false
OTP_PROVIDER=ses
ALLOW_LOCAL_OTP=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="INFIBOLT <no-reply@infibolt.com>"
RESEND_API_KEY=
SENDGRID_API_KEY=
AWS_SES_REGION=
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5
SENTRY_DSN=
LOG_LEVEL=info
# Required only when ALLOW_PRODUCTION_SEED=true for a controlled one-time seed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
GOOGLE_CLIENT_ID=714115878972-c65t9rnf3b9tv3j0a3al0lpr9dl6cj9l.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
SES_FROM_EMAIL="INFIBOLT <no-reply@infibolt.com>"
COOKIE_DOMAIN=.infibolt.com
COOKIE_SAME_SITE=none
ADMIN_WHITELIST=backend.admin.infi.simp@gmail.com
