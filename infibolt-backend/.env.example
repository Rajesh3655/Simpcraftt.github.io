NODE_ENV=production
HOST=0.0.0.0
PORT=3000
API_ORIGIN=https://api.infibolt.com
FRONTEND_ORIGIN=https://infibolt.com
ADMIN_ORIGIN=https://admin.infibolt.com
CORS_ORIGINS=https://infibolt.com,https://www.infibolt.com,https://admin.infibolt.com
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net
MONGODB_DB=infibolt_prod
JWT_ACCESS_SECRET=replace-with-64-byte-random-secret
JWT_REFRESH_SECRET=replace-with-different-64-byte-random-secret
COOKIE_SECRET=replace-with-different-64-byte-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
BCRYPT_ROUNDS=12
MAX_UPLOAD_BYTES=5242880
UPLOAD_PROVIDER=local
UPLOAD_BASE_PATH=/home/USER/domains/api.infibolt.com/infibolt-backend/uploads
ALLOW_PRODUCTION_SEED=false
OTP_PROVIDER=local
ALLOW_LOCAL_OTP=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="INFIBOLT <no-reply@infibolt.com>"
RESEND_API_KEY=
SENDGRID_API_KEY=
AWS_SES_REGION=
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5
SENTRY_DSN=
LOG_LEVEL=info
SEED_ADMIN_EMAIL=admin@infibolt.com
SEED_ADMIN_PASSWORD=replace-before-first-production-start
SEED_CUSTOMER_PASSWORD=replace-before-production-seeding
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
